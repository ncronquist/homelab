# Media Stack Configuration
# Copy this file to .env and fill in your values.

# Timezone
TZ=America/Los_Angeles

# User/Group IDs (run `id` to find yours)
PUID=501
PGID=20

# TransmissionVPN — PIA Configuration
VPN_PROVIDER=PIA
VPN_USERNAME=your-pia-username
VPN_PASSWORD=your-pia-password
LOCAL_NETWORK=192.168.1.0/24
