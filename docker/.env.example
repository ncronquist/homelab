# Global Configuration
# Copy this file to .env and fill in your values.
# DO NOT commit .env to git.

# Timezone (used by most services)
TZ=America/Los_Angeles

# User/Group IDs for LinuxServer.io containers
# Run `id` on macOS to find your values (typically UID=501, GID=20 on a first account)
PUID=501
PGID=20

# Domain for all services
DOMAIN=home.ncronquist.com

# External Storage — 4TB SSD mount path
# All media containers mount ${MEDIA_PATH} as /data inside the container.
# This unified mount enables hardlinks between torrents and final libraries.
# Before first launch, create the cache directory:
#   mkdir -p /Volumes/teamgroupqx/media/.cache/jellyfin
MEDIA_PATH=/Volumes/teamgroupqx/media
